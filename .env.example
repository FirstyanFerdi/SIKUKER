# ==========================================
# Google Gemini API Configuration for SIKUKER
# ==========================================
# Dapatkan API Key gratis di Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Pilihan Model Gemini (Gunakan model seri 3.x Flash-Lite untuk kecepatan dan stabilitas):
# - gemini-3.1-flash-lite    (Direkomendasikan: respon ~1-2 detik, aktif untuk pengguna baru)
# - gemini-flash-lite-latest (Versi rilis alias stabil terbaru)
# - gemini-3.8-flash         (Model penuh dengan kemampuan penalaran mendalam)
# - gemini-2.5-flash         (Legacy: mungkin 404 pada API key akun Google Cloud baru)
GEMINI_MODEL=gemini-3.1-flash-lite
